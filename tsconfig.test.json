{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // ルートは rootDir: "src" なので、test/ と設定ファイルを見た時点で
    // "not under rootDir" になる。型検査専用なので rootDir を広げて noEmit にする。
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src", "test", "vitest.config.ts"]
}
